<?xml version="1.0" encoding="utf-8"?>
<!--
    AccessibilityService Configuration
    ===================================
    Event types subscribed to — MINIMAL footprint to avoid SDK detection
    and reduce battery drain:

    - typeWindowStateChanged    : Detect when a new ad Activity opens (Phase 0)
    - typeWindowContentChanged  : Detect embedded WebView ad stage transitions (Phase 0b)

    Intentionally OMITTED (reduces event noise):
    - typeViewScrolled          : High-frequency, not needed — removed to cut battery use
    - typeViewClicked           : Would increase detection surface area unnecessarily
    - typeViewFocused           : Not needed for our use case
    - typeNotificationStateChanged : Not needed
-->
<accessibility-service
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds|flagRetrieveInteractiveWindows"
    android:canPerformGestures="true"
    android:canRetrieveWindowContent="true"
    android:description="@string/accessibility_service_description"
    android:notificationTimeout="16"
    android:settingsActivity=".MainActivity"
    android:summary="Automatically dismisses ads in games so you can play faster." />
